# Copy to .env; never put real keys in source control.
ROBOT_DATABASE_URL=sqlite:///./data/private/robot.db
# Local demonstration only; production uses independently issued user tokens.
ROBOT_DEMO_MODE=true
ROBOT_DEMO_TOKEN=local-demo-change-me
ROBOT_PROVIDER=demo
# To use a compatible service, set provider=compatible and fill all three values.
ROBOT_MODEL_BASE_URL=https://api.deepseek.com
ROBOT_MODEL_NAME=deepseek-flash
ROBOT_MODEL_API_KEY=
ROBOT_AUTO_WORKER=true
ROBOT_WORKER_POLL_SECONDS=0.5
