# Copy to .env; never put real keys in source control.
ROBOT_DATABASE_URL=sqlite:///./data/private/robot.db
# Local demonstration only; production uses independently issued user tokens.
ROBOT_DEMO_MODE=true
ROBOT_DEMO_TOKEN=local-demo-change-me
ROBOT_PROVIDER=demo
# To use a compatible service, set provider=compatible and fill all three values.
ROBOT_MODEL_BASE_URL=https://api.deepseek.com
ROBOT_MODEL_NAME=deepseek-flash
ROBOT_MODEL_API_KEY=
ROBOT_AUTO_WORKER=true
ROBOT_WORKER_POLL_SECONDS=0.5
# Optional semantic search. Run `robot prepare-model` before enabling local mode.
ROBOT_EMBEDDING_PROVIDER=none
ROBOT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ROBOT_EMBEDDING_DIMENSIONS=512
ROBOT_EMBEDDING_VERSION=1
ROBOT_EMBEDDING_CACHE_DIR=data/private/models
# Keep this journal separate from application DB snapshots. Do not replace it during restore.
ROBOT_DELETION_LEDGER_PATH=data/private/deletion-ledger.sqlite
