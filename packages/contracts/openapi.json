  "components": {
    "schemas": {
      "ConversationInput": {
        "properties": {
          "character_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Character Id",
            "default": "companion"
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title",
            "default": "新对话"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ConversationInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryInput": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Content"
          },
          "character_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Character Id",
            "default": "companion"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "preference",
              "event"
            ],
            "title": "Kind",
            "default": "fact"
          },
          "pinned": {
            "type": "boolean",
            "title": "Pinned",
            "default": false
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content"
        ],
        "title": "MemoryInput"
      },
      "MemoryPatch": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "content": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "pinned": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pinned"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "active",
                  "candidate"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "reason": {
            "type": "string",
            "enum": [
              "correction",
              "change",
              "confirmation"
            ],
            "title": "Reason",
            "default": "correction"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision"
        ],
        "title": "MemoryPatch"
      },
      "MessageInput": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          },
          "client_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Client Id"
          },
          "remember": {
            "type": "boolean",
            "title": "Remember",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content",
          "client_id"
        ],
        "title": "MessageInput"
      },
      "SettingsPatch": {
        "properties": {
          "memory_enabled": {
            "type": "boolean",
            "title": "Memory Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "memory_enabled"
        ],
        "title": "SettingsPatch"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
